# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/orqeli?schema=public
DATABASE_URL="postgresql://orqeli:replace_me@localhost:5432/orqeli?schema=public"
# API port and allowed browser origin. The Vite dev server proxies /api to this
# same PORT; uncomment the next line only to proxy somewhere else.
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# VITE_API_PROXY_TARGET="http://127.0.0.1:4000"
# Use a unique random secret with at least 32 characters. Never commit the real value.
SESSION_SECRET="replace_with_a_random_secret_of_at_least_32_characters"
# Session cookie settings
SESSION_COOKIE_NAME="orqeli.sid"
SESSION_TTL_HOURS=24
SESSION_COOKIE_SAMESITE="lax"
# Set to true when running behind a trusted reverse proxy in production
TRUST_PROXY=false
# Password recovery. This repository ships no e-mail/SMS provider, so the default
# is "disabled": /api/auth/password-reset/* answers 503 instead of reporting a
# success that never reaches the user. Set to "enabled" only after injecting a
# PasswordResetDelivery implementation; enabling it without one fails startup in
# production. See docs/deployment-checklist.md.
PASSWORD_RESET_MODE="disabled"

NODE_ENV="development"
