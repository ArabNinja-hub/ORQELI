# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/orqeli?schema=public
DATABASE_URL="postgresql://orqeli:replace_me@localhost:5432/orqeli?schema=public"
# API port and allowed browser origin
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Use a unique random secret with at least 32 characters. Never commit the real value.
SESSION_SECRET="replace_with_a_random_secret_of_at_least_32_characters"
# Session cookie settings
SESSION_COOKIE_NAME="orqeli.sid"
SESSION_TTL_HOURS=24
SESSION_COOKIE_SAMESITE="lax"
# Set to true when running behind a trusted reverse proxy in production
TRUST_PROXY=false
NODE_ENV="development"
