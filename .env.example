# PostgreSQL connection string for ORQELI Education
# Example: postgresql://USER:PASSWORD@localhost:5432/orqeli_education?schema=public
DATABASE_URL="postgresql://orqeli:replace_me@localhost:5432/orqeli_education?schema=public"

# API port and allowed browser origin. The Vite dev server proxies /api to PORT.
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# VITE_API_PROXY_TARGET="http://127.0.0.1:4000"

# Cryptographically random secret with at least 32 characters. Never commit a real secret.
SESSION_SECRET="replace_with_a_random_secret_of_at_least_32_characters"

# Session cookie settings
SESSION_COOKIE_NAME="orqeli.sid"
SESSION_TTL_HOURS=24
SESSION_COOKIE_SAMESITE="lax"

# Set to true when running behind a trusted reverse proxy in production
TRUST_PROXY=false

# Data store mode: "postgres" (default, required in production) or "memory-sandbox" (non-production synthetic evaluation only)
DATA_STORE_MODE="postgres"
NODE_ENV="development"
