generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  STANDARD
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum SchoolSector {
  GOVERNMENT
  PRIVATE
  COMMUNITY
}

enum SchoolStatus {
  PILOT_PREP
  ACTIVE
  SUSPENDED
}

enum SchoolRole {
  SCHOOL_ADMIN
  HEAD_TEACHER
  DEPUTY_HEAD
  TEACHER
  PARENT_GUARDIAN
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum TermNumber {
  TERM_1
  TERM_2
  TERM_3
}

enum ResultPackStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  APPROVED
  PUBLISHED
}

enum MarkEntryStatus {
  PENDING
  PRESENT
  ABSENT
  EXEMPT
}

enum CommunicationChannel {
  PRINT_REPORT
  SMS_SUMMARY
  GUARDIAN_PORTAL
}

enum StudentVerificationMethod {
  ENROLMENT_CODE
  STAFF_APPROVAL
}

enum StudentRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementAudience {
  STUDENTS_AND_STAFF
  STAFF_ONLY
}

model User {
  id                   String                       @id @default(cuid())
  email                String?                      @unique
  phone                String?                      @unique
  name                 String
  passwordHash         String?
  platformRole         PlatformRole                 @default(STANDARD)
  status               UserStatus                   @default(ACTIVE)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  memberships          SchoolMembership[]
  usedEnrolmentCodes   StudentEnrolmentCode[]       @relation("EnrolmentCodeUsedByUser")
  registrationRequests StudentRegistrationRequest[] @relation("StudentRegistrationApplicant")
  auditEvents          AuditEvent[]                 @relation("AuditActorUser")
}

model School {
  id                   String                       @id @default(cuid())
  code                 String                       @unique
  registrationNumber   String?                      @unique
  name                 String
  sector               SchoolSector
  province             String
  district             String
  levelSummary         String                       @default("Secondary (Grades 8-12)")
  publicDescription    String?
  studentPortalEnabled Boolean                      @default(false)
  phone                String?
  email                String?
  timezone             String                       @default("Africa/Lusaka")
  isSyntheticDemo      Boolean                      @default(true)
  status               SchoolStatus                 @default(PILOT_PREP)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  memberships          SchoolMembership[]
  academicYears        AcademicYear[]
  academicTerms        AcademicTerm[]
  classes              SchoolClass[]
  subjects             Subject[]
  allocations          ClassSubjectAllocation[]
  learners             Learner[]
  guardianLinks        LearnerGuardianLink[]
  studentLinks         LearnerStudentLink[]
  enrolmentCodes       StudentEnrolmentCode[]
  registrationRequests StudentRegistrationRequest[]
  announcements        SchoolAnnouncement[]
  resultPacks          TermResultPack[]
  subjectMarks         SubjectMark[]
  auditEvents          AuditEvent[]

  @@index([province, district])
  @@index([status])
  @@index([status, studentPortalEnabled])
}

model SchoolMembership {
  id                           String                       @id @default(cuid())
  schoolId                     String
  school                       School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId                       String
  user                         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                         SchoolRole
  status                       MembershipStatus             @default(ACTIVE)
  staffCode                    String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  homeroomClasses              SchoolClass[]                @relation("ClassTeacherMembership")
  subjectAllocations           ClassSubjectAllocation[]     @relation("AllocatedTeacherMembership")
  guardianLinks                LearnerGuardianLink[]
  studentLink                  LearnerStudentLink?          @relation("StudentAccountMembership")
  verifiedStudentLinks         LearnerStudentLink[]         @relation("StudentLinkVerifiedBy")
  createdEnrolmentCodes        StudentEnrolmentCode[]       @relation("EnrolmentCodeCreatedBy")
  revokedEnrolmentCodes        StudentEnrolmentCode[]       @relation("EnrolmentCodeRevokedBy")
  reviewedRegistrationRequests StudentRegistrationRequest[] @relation("RegistrationReviewedBy")
  publishedAnnouncements       SchoolAnnouncement[]         @relation("AnnouncementPublishedBy")
  submittedResultPacks         TermResultPack[]             @relation("PackSubmittedBy")
  reviewedResultPacks          TermResultPack[]             @relation("PackReviewedBy")
  approvedResultPacks          TermResultPack[]             @relation("PackApprovedBy")
  publishedResultPacks         TermResultPack[]             @relation("PackPublishedBy")
  enteredMarks                 SubjectMark[]                @relation("MarkEnteredBy")
  auditEvents                  AuditEvent[]                 @relation("AuditActorMembership")

  @@unique([schoolId, userId, role])
  @@index([userId, status])
  @@index([schoolId, role, status])
}

model AcademicYear {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year      Int
  label     String
  isCurrent Boolean        @default(false)
  startsOn  DateTime       @db.Date
  endsOn    DateTime       @db.Date
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  terms     AcademicTerm[]
  classes   SchoolClass[]

  @@unique([schoolId, year])
  @@index([schoolId, isCurrent])
}

model AcademicTerm {
  id             String           @id @default(cuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termNumber     TermNumber
  label          String
  isCurrent      Boolean          @default(false)
  startsOn       DateTime         @db.Date
  endsOn         DateTime         @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resultPacks    TermResultPack[]

  @@unique([academicYearId, termNumber])
  @@index([schoolId, isCurrent])
}

model SchoolClass {
  id                       String                   @id @default(cuid())
  schoolId                 String
  school                   School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId           String
  academicYear             AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name                     String
  gradeLevel               Int
  classTeacherMembershipId String?
  classTeacher             SchoolMembership?        @relation("ClassTeacherMembership", fields: [classTeacherMembershipId], references: [id], onDelete: SetNull)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  allocations              ClassSubjectAllocation[]
  learners                 Learner[]
  resultPacks              TermResultPack[]

  @@unique([academicYearId, name])
  @@index([schoolId, gradeLevel])
}

model Subject {
  id          String                   @id @default(cuid())
  schoolId    String
  school      School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code        String
  name        String
  isCore      Boolean                  @default(true)
  maxMark     Int                      @default(100)
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  allocations ClassSubjectAllocation[]
  marks       SubjectMark[]

  @@unique([schoolId, code])
  @@index([schoolId, active])
}

model ClassSubjectAllocation {
  id                  String           @id @default(cuid())
  schoolId            String
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolClassId       String
  schoolClass         SchoolClass      @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  subjectId           String
  subject             Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherMembershipId String
  teacherMembership   SchoolMembership @relation("AllocatedTeacherMembership", fields: [teacherMembershipId], references: [id], onDelete: Restrict)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([schoolClassId, subjectId])
  @@index([schoolId, teacherMembershipId])
}

model Learner {
  id                   String                       @id @default(cuid())
  schoolId             String
  school               School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNumber      String
  firstName            String
  lastName             String
  schoolClassId        String?
  schoolClass          SchoolClass?                 @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  guardianName         String?
  guardianPhone        String?
  preferredChannel     CommunicationChannel         @default(PRINT_REPORT)
  active               Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  guardianLinks        LearnerGuardianLink[]
  studentLink          LearnerStudentLink?
  enrolmentCodes       StudentEnrolmentCode[]
  registrationRequests StudentRegistrationRequest[]
  marks                SubjectMark[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, schoolClassId, active])
}

model LearnerGuardianLink {
  id           String           @id @default(cuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membershipId String
  membership   SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  learnerId    String
  learner      Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  relationship String
  createdAt    DateTime         @default(now())

  @@unique([membershipId, learnerId])
  @@index([schoolId, learnerId])
}

model LearnerStudentLink {
  id                     String                    @id @default(cuid())
  schoolId               String
  school                 School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membershipId           String                    @unique
  membership             SchoolMembership          @relation("StudentAccountMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  learnerId              String                    @unique
  learner                Learner                   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  verifiedByMembershipId String?
  verifiedBy             SchoolMembership?         @relation("StudentLinkVerifiedBy", fields: [verifiedByMembershipId], references: [id], onDelete: SetNull)
  verificationMethod     StudentVerificationMethod
  createdAt              DateTime                  @default(now())

  @@index([schoolId])
}

model StudentEnrolmentCode {
  id                    String            @id @default(cuid())
  schoolId              String
  school                School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  learnerId             String
  learner               Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  codeHash              String            @unique
  codeHint              String
  expiresAt             DateTime
  usedAt                DateTime?
  usedByUserId          String?
  usedByUser            User?             @relation("EnrolmentCodeUsedByUser", fields: [usedByUserId], references: [id], onDelete: SetNull)
  revokedAt             DateTime?
  revokedByMembershipId String?
  revokedBy             SchoolMembership? @relation("EnrolmentCodeRevokedBy", fields: [revokedByMembershipId], references: [id], onDelete: SetNull)
  createdByMembershipId String
  createdBy             SchoolMembership  @relation("EnrolmentCodeCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  createdAt             DateTime          @default(now())

  @@index([schoolId, learnerId])
  @@index([schoolId, expiresAt])
}

model StudentRegistrationRequest {
  id                       String                    @id @default(cuid())
  schoolId                 String
  school                   School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User                      @relation("StudentRegistrationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  submittedAdmissionNumber String
  applicantName            String
  classHint                String?
  status                   StudentRegistrationStatus @default(PENDING)
  linkedLearnerId          String?
  linkedLearner            Learner?                  @relation(fields: [linkedLearnerId], references: [id], onDelete: SetNull)
  reviewedByMembershipId   String?
  reviewedBy               SchoolMembership?         @relation("RegistrationReviewedBy", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  reviewedAt               DateTime?
  decisionNotes            String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([schoolId, status, createdAt])
  @@index([userId, status])
}

model SchoolAnnouncement {
  id                      String               @id @default(cuid())
  schoolId                String
  school                  School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title                   String
  body                    String
  audience                AnnouncementAudience @default(STUDENTS_AND_STAFF)
  publishedByMembershipId String?
  publishedBy             SchoolMembership?    @relation("AnnouncementPublishedBy", fields: [publishedByMembershipId], references: [id], onDelete: SetNull)
  publishedAt             DateTime             @default(now())
  createdAt               DateTime             @default(now())

  @@index([schoolId, publishedAt])
}

model TermResultPack {
  id                      String            @id @default(cuid())
  schoolId                String
  school                  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicTermId          String
  academicTerm            AcademicTerm      @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  schoolClassId           String
  schoolClass             SchoolClass       @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  status                  ResultPackStatus  @default(DRAFT)
  reviewNotes             String?
  submittedAt             DateTime?
  submittedByMembershipId String?
  submittedBy             SchoolMembership? @relation("PackSubmittedBy", fields: [submittedByMembershipId], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?
  reviewedByMembershipId  String?
  reviewedBy              SchoolMembership? @relation("PackReviewedBy", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)
  approvedAt              DateTime?
  approvedByMembershipId  String?
  approvedBy              SchoolMembership? @relation("PackApprovedBy", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  publishedAt             DateTime?
  publishedByMembershipId String?
  publishedBy             SchoolMembership? @relation("PackPublishedBy", fields: [publishedByMembershipId], references: [id], onDelete: SetNull)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  marks                   SubjectMark[]

  @@unique([academicTermId, schoolClassId])
  @@index([schoolId, status])
}

model SubjectMark {
  id                    String            @id @default(cuid())
  schoolId              String
  school                School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termResultPackId      String
  termResultPack        TermResultPack    @relation(fields: [termResultPackId], references: [id], onDelete: Cascade)
  learnerId             String
  learner               Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subjectId             String
  subject               Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  status                MarkEntryStatus   @default(PENDING)
  score                 Int?
  teacherComment        String?
  enteredByMembershipId String?
  enteredBy             SchoolMembership? @relation("MarkEnteredBy", fields: [enteredByMembershipId], references: [id], onDelete: SetNull)
  enteredAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([termResultPackId, learnerId, subjectId])
  @@index([schoolId, termResultPackId, subjectId])
  @@index([schoolId, learnerId])
}

model AuditEvent {
  id                String            @id @default(cuid())
  schoolId          String?
  school            School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actorUserId       String?
  actorUser         User?             @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembershipId String?
  actorMembership   SchoolMembership? @relation("AuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: SetNull)
  action            String
  entityType        String
  entityId          String
  beforeState       Json?
  afterState        Json?
  metadata          Json?
  createdAt         DateTime          @default(now())

  @@index([schoolId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
