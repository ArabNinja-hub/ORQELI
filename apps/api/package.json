{
  "name": "@orqeli/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:sandbox": "NODE_ENV=development DATA_STORE_MODE=memory-sandbox DATABASE_URL=postgresql://sandbox-unused@localhost:5432/orqeli_sandbox SESSION_SECRET=local-synthetic-sandbox-secret-not-for-production tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed-synthetic": "tsx scripts/seed-synthetic-db.ts",
    "db:verify-flow": "tsx scripts/verify-db-flow.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.7.2",
    "prisma": "^6.17.1",
    "tsx": "^4.20.6"
  }
}
